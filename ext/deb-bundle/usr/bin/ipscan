#!/bin/sh
java=$JAVA_HOME/bin/java
[ ! -x "$java" ] && java=java
"$java" --add-opens java.base/java.net=ALL-UNNAMED --enable-native-access=ALL-UNNAMED -jar /usr/lib*/ipscan/ipscan*.jar "$@"
status=$?
if [ "$status" -ne 0 ] && command -v notify-send >/dev/null 2>&1; then
    notify-send "Advanced IP Analyser exited with status $status. Run ipscan from a terminal for details."
fi
exit "$status"
