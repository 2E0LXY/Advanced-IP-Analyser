#!/bin/sh
java=$JAVA_HOME/bin/java
[ ! -x "$java" ] && java=java
jar=${IPSCAN_JAR:-}
if [ -z "$jar" ]; then
    for candidate in /usr/lib/ipscan/Advanced-IP-Analyser-*-linux64.jar; do
        jar=$candidate
        break
    done
fi
if [ ! -f "$jar" ]; then
    echo "Advanced IP Analyser application JAR was not found: $jar" >&2
    exit 1
fi
"$java" --add-opens java.base/java.net=ALL-UNNAMED --enable-native-access=ALL-UNNAMED -jar "$jar" "$@"
status=$?
if [ "$status" -ne 0 ] && command -v notify-send >/dev/null 2>&1; then
    notify-send "Advanced IP Analyser exited with status $status. Run ipscan from a terminal for details."
fi
exit "$status"
