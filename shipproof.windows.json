{
  "schema_version": 1,
  "project": "Advanced IP Analyser / Windows",
  "checks": [
    {
      "id": "shipproof-self-tests",
      "argv": [
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_shipproof.py",
        "-q"
      ],
      "stages": [
        "release"
      ],
      "timeout_seconds": 90,
      "required": true,
      "min_tests": 9
    }
  ],
  "required_artifacts": [
    "dist/windows-installer/Advanced-IP-Analyser-Setup-*.exe"
  ]
}
